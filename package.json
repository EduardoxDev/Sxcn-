{
  "name": "scxn",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Scxn — private screenshare sessions.",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w @scxn/server\" \"npm run dev -w @scxn/client\"",
    "build": "npm run typecheck && npm run build -w @scxn/client && npm run build -w @scxn/server",
    "start": "npm run start -w @scxn/server",
    "lint": "eslint .",
    "typecheck": "tsc -p shared --noEmit && tsc -p server --noEmit && tsc -p client --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
