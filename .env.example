# ── Server ─────────────────────────────────────────────
# Port for Express + Socket.IO (signaling).
PORT=3001
# Comma-separated list of allowed browser origins (only needed when the client is served
# from a different origin than the server). Leave empty for same-origin / dev proxy.
CORS_ORIGINS=
# Trust X-Forwarded-For (set to 1 behind a reverse proxy / load balancer).
TRUST_PROXY=0

# ── Rooms ──────────────────────────────────────────────
MAX_PARTICIPANTS=8
MAX_ROOMS=500
# How long a disconnected participant keeps their seat (ms).
RECONNECT_GRACE_MS=30000

# ── WebRTC / ICE ───────────────────────────────────────
# Comma-separated STUN URLs.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Optional TURN relay (strongly recommended in production — required behind symmetric NAT).
# Comma-separated URLs, e.g. turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Client (Vite) ──────────────────────────────────────
# Signaling URL used by the browser. Empty = same origin (recommended).
VITE_SIGNALING_URL=
